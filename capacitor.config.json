{
  "appId": "com.oralzon.myapp",
  "appName": "Oralzon",
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0F7A68",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": "atBackground",
      "appId": "com.oralzon.myapp",
      "version": "0.0.0"
    }
  }
}
