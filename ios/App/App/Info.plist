<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Oralzon</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Export compliance / dichiarazione crittografia.

	  Oralzon usa ESCLUSIVAMENTE la crittografia fornita dal sistema
	  operativo: HTTPS attraverso la WebView, APNs per le notifiche push,
	  e Stripe che si apre nel browser esterno. Nessuna libreria
	  crittografica di terze parti, nessun algoritmo implementato in
	  proprio. Questo rientra nell'esenzione dichiarata da Apple per
	  l'uso della crittografia integrata nell'OS.

	  Senza questa chiave, App Store Connect ripropone il questionario di
	  export compliance a ogni build e, dichiarando la distribuzione in
	  Francia, richiede il modulo ANSSI (décret n°2007-663) — che nel
	  nostro caso non e' dovuto.

	  ATTENZIONE: se un giorno si aggiunge cifratura propria (es.
	  cifratura locale dei dati, un plugin crypto, una libreria di
	  terze parti che implementa AES/RSA per conto suo), questa
	  dichiarazione diventa FALSA e va rivista prima della pubblicazione.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  CAUSA DEL RIFIUTO APPLE del 16/08/2026 (Guideline 2.1(a) - Performance).
	  Revisione su iPad Air 11" (M3), iPadOS 26.6: accesso come venditore,
	  aggiunta prodotto, tocco su "Scatta foto" -> APP TERMINATA.

	  Non era un difetto del codice JavaScript. Il caricamento immagini usa
	  un normale campo file (src/app/components/ImageUploader.tsx): su iOS
	  il sistema propone "Scatta foto" e "Libreria foto", e nel momento in
	  cui l'utente sceglie una delle due iOS pretende di trovare qui la
	  dichiarazione del motivo per cui l'app accede a fotocamera e foto.

	  Se la dichiarazione manca iOS NON restituisce un errore gestibile:
	  termina il processo all'istante. Dal punto di vista di chi revisiona
	  e' indistinguibile da un crash, ed e' il motivo per cui il log non
	  mostrava alcuna eccezione dell'applicazione.

	  Il testo di queste stringhe viene mostrato TESTUALMENTE nel dialogo di
	  autorizzazione, quindi e' scritto per l'utente e spiega a cosa serve —
	  Apple rifiuta anche descrizioni generiche del tipo "serve per la
	  fotocamera".

	  NOTA PER IL FUTURO: ogni nuova funzione che tocchi una risorsa
	  protetta (microfono, posizione, contatti, calendario) richiede la
	  propria chiave qui, altrimenti si ripresenta esattamente questo
	  problema — un'app che termina senza lasciare traccia.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Oralzon usa la fotocamera per permetterti di fotografare i prodotti che metti in vendita e allegarli alla scheda prodotto.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Oralzon accede alle tue foto per permetterti di scegliere le immagini dei prodotti che metti in vendita.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Oralzon salva nelle tue foto le immagini dei prodotti quando scegli di scaricarle.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Oralzon non registra audio. Questa autorizzazione viene richiesta dal sistema solo quando scatti un video di un prodotto dalla fotocamera.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.oralzon.myapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oralzon</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
